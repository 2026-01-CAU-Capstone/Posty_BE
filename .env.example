# 이 파일을 .env.local 로 복사한 뒤 본인 키로 채우세요.
# (.env.local 은 .gitignore 에 의해 커밋되지 않습니다)

# ---- Gemini (Stage 0, 1, 4 narration) ----
GEMINI_API_KEY=
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ---- OpenAI (Stage 1 embedding) ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- FFmpeg / FFprobe (모두 PATH 에 있으면 그대로 두세요) ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
