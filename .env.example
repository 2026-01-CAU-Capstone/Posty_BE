# 이 파일을 .env.local 로 복사한 뒤 본인 키로 채우세요.
# (.env.local 은 .gitignore 에 의해 커밋되지 않습니다)

# ---- Gemini (Stage 0, 1, 4 narration) ----
GEMINI_API_KEY=
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ---- OpenAI (Stage 1 embedding + 긴 소스 축약 선별) ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 긴 소스(추정 출력 60초 초과)일 때 최종 컷 선별에 쓰는 chat 모델. 기본 gpt-4o-mini.
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- FFmpeg / FFprobe (모두 PATH 에 있으면 그대로 두세요) ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 선택: scene detection 의 GPU decode 가속. Windows 는 d3d11va 가 가장 호환 좋음 (NVIDIA 면 cuda 도 가능).
# 긴/고해상도 소스의 진짜 병목인 "디코드" 를 GPU 로 넘겨 크게 빨라질 수 있음.
# 단, 일부 노트북에서 화면 깜빡임(TDR) 유발 가능 — 그러면 빈 값으로 되돌리세요. 기본=비활성(CPU).
# FFMPEG_HWACCEL=d3d11va
# 선택(CPU 전용 레버): GPU 를 못 쓸 때 B프레임 decode 를 건너뛰어 CPU 디코드량을 ~30~50% 줄임.
# 모션 많은 영상은 컷이 과분할될 수 있음(다운스트림 큐레이션이 흡수). '1' 로 켬.
# FFMPEG_SCENE_SKIP_NONREF=1

# ---- BGM 지문인식 (Stage 4: 레퍼런스에 실제 쓰인 곡 식별) — 선택 ----
# AudD.io 토큰. https://dashboard.audd.io 에서 발급.
# 비워두면 식별은 건너뛰고 기존 vibe 기반 무료 BGM 자동매칭만 동작합니다.
# (식별된 상용곡은 저작권상 결과물에 넣지 않고, 장르/시대 힌트로 무료트랙 매칭만 보강)
AUDD_API_TOKEN=
