# ===== Database =====
DATABASE_URL=postgresql://posty:posty@localhost:5432/posty

# ===== Server =====
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ===== yt-dlp =====
YTDLP_TIMEOUT=30
YTDLP_RETRIES=2

# ===== Cache =====
CACHE_TTL_SECONDS=86400

# ===== Instagram 인증 (사진 Post fetch에 필수) =====
# 사진 Post는 비로그인으로 fetch가 거의 불가능하므로 새로 만든 IG 계정의
# 쿠키를 설정해두세요. 둘 중 하나만 채우면 됩니다 (둘 다면 IG_COOKIES_FILE 우선).

# (방식 A) cookies.txt 파일 경로 - 권장
# 브라우저에서 "Get cookies.txt LOCALLY" 같은 확장으로 추출해서 저장.
# IG_COOKIES_FILE=/Users/you/secrets/ig_cookies.txt

# (방식 B) sessionid 값만 - 간단 모드
# 브라우저 DevTools > Application > Cookies > instagram.com 에서 'sessionid' 복사.
# ds_user_id도 같이 넣으면 더 안정적.
# IG_SESSIONID=...
# IG_DS_USER_ID=...

# 쿠키 추출한 브라우저와 같은 UA를 쓰면 fingerprint 검사를 통과하기 쉽다.
# IG_USER_AGENT=Mozilla/5.0 (...)

# 미디어 proxy 엔드포인트 활성화 (응답에 proxy_url 필드 포함)
ENABLE_MEDIA_PROXY=True


# ===== 미디어 영구 저장 =====
# 'local'(개발 기본) | 's3'(배포) | 'none'(저장 안 함, 즉시 만료되는 IG CDN URL만 사용)
STORAGE_BACKEND=local

# ----- local 모드 -----
LOCAL_STORAGE_DIR=./storage
# 외부에서 접근할 base URL. 운영 시에는 도메인을 적으세요.
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000/static

# ----- s3 모드 -----
# 배포 시 STORAGE_BACKEND=s3 로 바꾸고 아래를 채우세요.
# S3_BUCKET=my-posty-media
# S3_REGION=ap-northeast-2
# S3_PREFIX=media          # (선택) bucket 내 prefix. 비워두면 root에 저장.
# CloudFront/커스텀 도메인. 비워두면 표준 s3 URL 사용.
# S3_PUBLIC_URL_BASE=https://d123abc.cloudfront.net
# S3 호환 서비스(MinIO 등) 쓸 때만. AWS면 비워둘 것.
# S3_ENDPOINT_URL=

# AWS 자격증명은 별도로 설정 (~/.aws/credentials, IAM role, 또는 환경변수)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# 저작권 대응: 며칠 후 자동 삭제. 0이면 자동 삭제 안 함.
# scripts/cleanup_expired_media.py를 cron으로 돌릴 때 이 값을 참조.
MEDIA_RETENTION_DAYS=7
